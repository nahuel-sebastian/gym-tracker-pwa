# Credenciales del proyecto de PRODUCCIÓN en supabase.com.
# Copia este archivo a .env.production.local (lo ignora git por el patrón *.local).
#
# Vite solo lee este archivo al construir (`npm run build`), así que `npm run dev`
# sigue apuntando a la base local de .env.local.
#
# OJO: esto vale para construir en tu máquina. Si despliegas en Vercel o
# Cloudflare Pages, las dos variables hay que meterlas ADEMÁS en el panel del
# host: el archivo no se sube al repositorio.
VITE_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=
